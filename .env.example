# Token Bot Telegram dari @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Username Bot Telegram tanpa tanda @ (misal: BismillahNikah_bot)
BOT_USERNAME=BismillahNikah_bot

# Database PostgreSQL URL (Neon.tech / Supabase / Local PostgreSQL)
# Format asyncpg: postgresql+asyncpg://username:password@ep-sample-12345.us-east-2.aws.neon.tech/neondb?ssl=require
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/bismillah_nikah_db

# Webhook Secret Token (opsional untuk verifikasi header X-Telegram-Bot-Api-Secret-Token)
WEBHOOK_SECRET=your_random_secret_token_here
